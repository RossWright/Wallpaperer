<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Wallpaperer.Controls"
        xmlns:vm="using:Wallpaperer.ViewModels"
        x:Class="Wallpaperer.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Wallpaperer"
        Icon="avares://Wallpaperer/Assets/wallpaperer.png"
        Width="1100"
        Height="800"
        MinWidth="860"
        MinHeight="640"
        WindowStartupLocation="CenterScreen">
  <Grid RowDefinitions="Auto,Auto,*,Auto">
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="20,16,20,8">
      <TextBlock Text="Wallpaperer"
                 FontSize="22"
                 FontWeight="SemiBold"
                 VerticalAlignment="Center"
                 TextTrimming="CharacterEllipsis"/>
      <StackPanel Grid.Column="1"
                  Orientation="Horizontal"
                  Spacing="14"
                  VerticalAlignment="Center">
        <Button Content="Apply"
                Command="{Binding ApplyCommand}"
                IsVisible="{Binding !AutoApply}"
                MinWidth="112"
                Height="36"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"/>
        <ToggleSwitch Content="Auto-apply"
                      IsChecked="{Binding AutoApply, Mode=TwoWay}"
                      OnContent="On"
                      OffContent="Off"
                      VerticalAlignment="Center"
                      ToolTip.Tip="Apply the wallpaper you are editing about half a second after each change"/>
      </StackPanel>
    </Grid>

    <Border Grid.Row="1"
            Height="368"
            Margin="20,4,20,8"
            CornerRadius="12"
            Background="#14161B"
            BorderBrush="#3A4150"
            BorderThickness="1"
            ClipToBounds="True">
      <controls:MonitorArrangement/>
    </Border>

    <Border Grid.Row="2"
            Margin="20,0,20,8"
            CornerRadius="12"
            BorderThickness="1"
            BorderBrush="#66808080"
            Padding="8">
      <Grid RowDefinitions="Auto,*">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
          <ComboBox ItemsSource="{Binding SizeFilters}"
                    SelectedItem="{Binding SelectedSizeFilter, Mode=TwoWay}"
                    MinWidth="280"
                    MaxWidth="560"
                    ToolTip.Tip="Pictures within 12% of this resolution"/>
          <Button Content="Refresh"
                  Command="{Binding RefreshPicturesCommand}"
                  MinWidth="96"
                  Padding="12,0"
                  VerticalAlignment="Center"
                  ToolTip.Tip="Scan the home folder for pictures again"/>
        </StackPanel>
        <controls:PictureGallery Grid.Row="1"/>
      </Grid>
    </Border>

    <Grid Grid.Row="3" Margin="20,4,20,14" ColumnDefinitions="*,Auto">
      <StackPanel Spacing="2" VerticalAlignment="Center">
        <TextBlock Text="{Binding Status}" TextWrapping="Wrap"/>
        <TextBlock Text="{Binding LayoutWarning}"
                   TextWrapping="Wrap"
                   Foreground="#E0A040"
                   IsVisible="{Binding HasLayoutWarning}"/>
      </StackPanel>
      <Button Grid.Column="1"
              Content="{Binding UpdateButtonLabel}"
              Command="{Binding UpdateCommand}"
              IsVisible="{Binding UpdateAvailable}"
              Margin="16,0,0,0"
              Padding="12,6"
              VerticalAlignment="Center"/>
    </Grid>
  </Grid>
</Window>
