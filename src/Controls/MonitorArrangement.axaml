<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Wallpaperer.ViewModels"
             x:Class="Wallpaperer.Controls.MonitorArrangement"
             x:DataType="vm:MainWindowViewModel">
  <Grid>
    <Canvas x:Name="Surface"/>
    <TextBlock Margin="12,8,12,0"
               FontSize="13"
               Foreground="#C5CAD3"
               TextWrapping="Wrap"
               IsHitTestVisible="False"
               VerticalAlignment="Top"
               HorizontalAlignment="Left"
               xml:space="preserve">- Click a screen to select it.
- Click and drag to select a span of screens.
- Hold Ctrl or Shift and click to select a span.
- Then click an image below to set the wallpaper.</TextBlock>
    <TextBlock Text="No monitors detected."
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               Foreground="#C5CAD3"
               IsVisible="{Binding !HasMonitors}"/>
  </Grid>
</UserControl>
