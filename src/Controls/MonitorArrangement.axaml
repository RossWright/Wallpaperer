<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Wallpaperer.ViewModels"
             x:Class="Wallpaperer.Controls.MonitorArrangement"
             x:DataType="vm:MainWindowViewModel">
  <Grid>
    <Canvas x:Name="Surface"/>
    <TextBlock Text="1) Click a screen or CTRL-click or click-drag multiple to select a span. 2) Click a wallpaper to set it for the screen/span"
               Margin="12,8,12,0"
               FontSize="13"
               Foreground="#C5CAD3"
               TextWrapping="Wrap"
               IsHitTestVisible="False"
               VerticalAlignment="Top"
               HorizontalAlignment="Left"/>
    <TextBlock Text="No monitors detected."
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               Foreground="#C5CAD3"
               IsVisible="{Binding !HasMonitors}"/>
  </Grid>
</UserControl>
