<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Wallpaperer.ViewModels"
             x:Class="Wallpaperer.Controls.ThumbnailTile"
             x:DataType="vm:PictureItemViewModel"
             ToolTip.Tip="{Binding Tooltip}"
             Cursor="Hand">
  <Border Background="#2A2E36"
          BorderBrush="#55606878"
          BorderThickness="1"
          CornerRadius="8"
          ClipToBounds="True">
    <Grid>
      <Image Source="{Binding Thumbnail}" Stretch="Uniform"/>
      <Border VerticalAlignment="Bottom"
              HorizontalAlignment="Center"
              Margin="4,0,4,4"
              Padding="6,1"
              CornerRadius="3"
              Background="#C0101218"
              IsVisible="{Binding HasResolution}"
              IsHitTestVisible="False">
        <TextBlock Text="{Binding ResolutionLabel}"
                   FontSize="11"
                   Foreground="White"
                   FontWeight="{Binding ResolutionWeight}"
                   TextAlignment="Center"/>
      </Border>
    </Grid>
  </Border>
</UserControl>
