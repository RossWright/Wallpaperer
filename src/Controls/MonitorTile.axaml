<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Wallpaperer.ViewModels"
             x:Class="Wallpaperer.Controls.MonitorTile"
             x:DataType="vm:MonitorViewModel"
             x:Name="Root">
  <Border x:Name="Frame"
          Background="#1B1E24"
          BorderBrush="#6A7382"
          BorderThickness="1"
          CornerRadius="6"
          ClipToBounds="True">
    <Grid>
      <Image Source="{Binding Preview}" Stretch="UniformToFill"/>
      <Border Background="#334EA1FF"
              IsVisible="{Binding IsSelected}"
              IsHitTestVisible="False"/>
      <Border HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Margin="8"
              Padding="8,4"
              CornerRadius="4"
              Background="#C0101218"
              IsHitTestVisible="False">
        <StackPanel Spacing="2">
          <TextBlock Text="{Binding Title}"
                     Foreground="White"
                     FontSize="13"
                     TextAlignment="Center"
                     TextWrapping="Wrap"/>
          <TextBlock Text="{Binding Detail}"
                     Foreground="#D5DAE3"
                     FontSize="11"
                     TextAlignment="Center"
                     TextWrapping="Wrap"/>
        </StackPanel>
      </Border>
      <Button Command="{Binding ClearCommand}"
              IsVisible="{Binding HasImage}"
              HorizontalAlignment="Right"
              VerticalAlignment="Top"
              Margin="6"
              Width="28"
              Height="28"
              Padding="5"
              Background="#B0101218"
              BorderThickness="0"
              ToolTip.Tip="Clear">
        <Path Stroke="White"
              StrokeThickness="1.8"
              StrokeLineCap="Round"
              Stretch="Uniform"
              Data="M5,5 L15,15 M15,5 L5,15"/>
      </Button>
    </Grid>
  </Border>
</UserControl>
